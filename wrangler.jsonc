// Cloudflare Worker config for the Next.js web app (built with OpenNext).
// The realtime room server has its own config in worker/wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-together-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "quiz-together-web"
    }
  ],
  "observability": {
    "enabled": true
  }
}
