# Copy to .env.local for local development (and .env.production before `npm run deploy:web`).
#
# Base URL of the realtime Worker (Durable Object room server).
# Local:      http://localhost:8787   (started by `npm run dev`)
# Production: https://quiz-together-realtime.<your-subdomain>.workers.dev
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
NEXT_PUBLIC_REALTIME_URL=http://localhost:8787
